# Required connection values supplied by the server administrator.
# Each computer must use its own enrolled device token. Do not reuse this file
# on another computer.
SYNC_SERVER_ADDRESS=server.example.com:8443
SYNC_DEVICE_TOKEN=replace-with-device-token-at-least-32-characters
# This is the authorized starting folder. When you select multiple local
# folders, the server assigns a separate remote folder to each selection.
SYNC_FOLDER_ID=00000000-0000-0000-0000-000000000000

# Leave both values empty to discover Codex and Claude worktrees and choose one
# or more interactively. SYNC_WORKTREE keeps the single-folder format.
# SYNC_WORKTREES accepts comma-separated discovered IDs or absolute paths.
SYNC_WORKTREE=
SYNC_WORKTREES=
SYNC_WORKTREE_PROVIDERS=all

# To synchronize ordinary directories instead of discovered worktrees, set
# SYNC_ROOT for one directory or SYNC_ROOTS to an operating-system path list.
# SYNC_ROOT=
# SYNC_ROOTS=

# Multiple folders automatically receive independent SQLite state files here.
# SYNC_STATE_DIR=
# SYNC_FOLDER_MAP_PATH=

# Keep false for normal TLS connections. Use true only for a trusted local test server.
ALLOW_INSECURE=false
# TLS_SERVER_NAME=
# TLS_CA_FILE=

SCAN_INTERVAL=15m
WATCH_DEBOUNCE=500ms
