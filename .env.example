# Select bundled or external. The setup script asks before writing .env.
DATABASE_MODE=bundled
COMPOSE_PROJECT_NAME=remote-sync

# Bundled PostgreSQL settings.
POSTGRES_DB=remote_sync
POSTGRES_USER=remote_sync
POSTGRES_PASSWORD=
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Required only when DATABASE_MODE=external.
DATABASE_URL=

# Server bootstrap identity.
SYNC_USER_ID=
SYNC_DEVICE_ID=
SYNC_FOLDER_ID=
SYNC_DEVICE_TOKEN=

# Safe local defaults. Configure TLS before exposing the server publicly.
REMOTE_SYNC_BIND_ADDRESS=127.0.0.1
REMOTE_SYNC_PORT=8443
REMOTE_SYNC_IMAGE=remote-sync:local
ALLOW_INSECURE=true
DEV_BOOTSTRAP=true

# Optional runtime limits.
MAX_FILE_SIZE_BYTES=10737418240
MAX_FOLDER_LIVE_SIZE_BYTES=1099511627776
MAX_USER_LIVE_SIZE_BYTES=1099511627776
MAX_PENDING_UPLOAD_SIZE_BYTES=21474836480
MAX_CHUNK_SIZE_BYTES=1048576
